@import "tailwindcss";

@theme {
  /* ============================================================
     NAIOM · Planto Dark (avril 2026)
     Fond sombre vert profond · glass noir translucide ·
     typo élégante · accents orange NAIOM.
     Inspiration : Planto interactive portfolio (Figma).
     ============================================================ */

  /* Dark surface palette */
  --color-bg:           #0a1410;  /* vert-noir profond */
  --color-bg-soft:      #122019;  /* surface secondaire */
  --color-bg-card:      #1a2821;  /* card base */

  /* Ink = texte clair (on dark) */
  --color-ink:          #F5F1E8;
  --color-ink-soft:     #C2BDB0;
  --color-ink-dim:      #7A7568;

  /* Accents brand NAIOM (conservés) */
  --color-accent:       #E8461F;
  --color-accent-hover: #F57444;
  --color-accent-soft:  #FFB199;

  /* Vert foncé NAIOM — à utiliser pour les textes sur fonds clairs/translucides */
  --color-on-light:     #0a1410;
  --color-on-light-soft: #1e3a2c;
  --color-pink:         #F574AB;
  --color-purple:       #B464D3;
  --color-emerald:      #10B981;
  --color-amber:        #F59E0B;

  /* Legacy aliases (composants existants) — remapping vers dark palette.
     marine-600/700/800/900 sont utilisés à la fois comme FOND (avec text-white)
     et comme COULEUR DE TEXTE (sur fonds clairs). Dans les deux cas, le vert
     foncé NAIOM (#0a1410) est la bonne cible : text-white reste lisible sur
     fond vert foncé, et vert foncé reste lisible sur les glass-cards claires. */
  --color-marine-50:   rgba(255, 255, 255, 0.06);
  --color-marine-100:  rgba(255, 255, 255, 0.12);
  --color-marine-200:  #3A4A3F;
  --color-marine-400:  #7A7568;
  --color-marine-600:  #1e3a2c;
  --color-marine-700:  #0a1410;
  --color-marine-800:  #0a1410;
  --color-marine-900:  #0a1410;

  --color-nude-50:   rgba(232, 70, 31, 0.1);
  --color-nude-100:  rgba(232, 70, 31, 0.2);
  --color-nude-200:  #FFB199;
  --color-nude-300:  #F57444;
  --color-nude-500:  #E8461F;

  --color-cream:        #0a1410;
  --color-cream-light:  rgba(255, 255, 255, 0.04);
  --color-cream-dark:   rgba(255, 255, 255, 0.14);

  --color-surface: #122019;
  --color-muted:   #7A7568;
  --color-line:    rgba(255, 255, 255, 0.1);

  --font-sans: "Inter", ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, "SFMono-Regular", "Menlo", "Monaco", "Courier New", monospace;

  /* Shadows pour dark mode */
  --shadow-glow-orange: 0 0 60px -10px rgba(232, 70, 31, 0.5);
  --shadow-glow-subtle: 0 8px 40px -12px rgba(0, 0, 0, 0.6);
}

:root {
  color-scheme: dark;
}

html, body {
  color: var(--color-ink);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

/* ============================================================
   Background : dégradé dark vert + halos colorés animés
   ============================================================ */
body {
  background:
    radial-gradient(ellipse at top left, #0f1f18 0%, #0a1410 50%, #060d0a 100%);
  background-attachment: fixed;
  position: relative;
}
body::before {
  content: "";
  position: fixed; inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(circle at 90% 10%, rgba(232, 70, 31, 0.18) 0%, transparent 35%),
    radial-gradient(circle at 5% 50%, rgba(180, 100, 211, 0.12) 0%, transparent 35%),
    radial-gradient(circle at 70% 95%, rgba(245, 116, 171, 0.1) 0%, transparent 35%),
    radial-gradient(circle at 50% 30%, rgba(16, 185, 129, 0.08) 0%, transparent 40%);
  filter: blur(40px);
  animation: halos-drift 40s ease-in-out infinite;
}
@keyframes halos-drift {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(2%, -1%) scale(1.04); }
}

*:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
  border-radius: 6px;
}

/* ============================================================
   Utility classes — Planto Dark Glass
   ============================================================ */

/* Carte glass sombre — principale */
.glass-brutal {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(24px) saturate(140%);
  -webkit-backdrop-filter: blur(24px) saturate(140%);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  box-shadow:
    0 1px 0 0 rgba(255, 255, 255, 0.06) inset,
    0 20px 60px -20px rgba(0, 0, 0, 0.6);
}

/* Carte glass douce (sous-éléments) */
.glass-soft {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(16px) saturate(130%);
  -webkit-backdrop-filter: blur(16px) saturate(130%);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 18px;
}

/* Carte glass très légère (inputs, petits éléments) */
.glass-frost {
  background: rgba(255, 255, 255, 0.025);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 14px;
}

/* Card hover accent orange glow */
.glass-card-hover {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.glass-card-hover:hover {
  transform: translateY(-4px);
  border-color: rgba(232, 70, 31, 0.4);
  box-shadow:
    0 1px 0 0 rgba(255, 255, 255, 0.08) inset,
    0 30px 80px -20px rgba(232, 70, 31, 0.3),
    0 20px 60px -20px rgba(0, 0, 0, 0.7);
}

/* Bouton primaire orange */
.btn-accent {
  background: var(--color-accent);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 999px;
  font-weight: 600;
  padding: 10px 20px;
  letter-spacing: 0.02em;
  box-shadow: 0 10px 30px -10px rgba(232, 70, 31, 0.6);
  transition: all 0.2s ease;
}
.btn-accent:hover { transform: translateY(-1px); box-shadow: 0 14px 36px -10px rgba(232, 70, 31, 0.8); background: var(--color-accent-hover); }

/* Bouton ghost */
.btn-ghost {
  background: rgba(255, 255, 255, 0.05);
  color: var(--color-ink);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 999px;
  font-weight: 600;
  padding: 10px 20px;
  backdrop-filter: blur(12px);
  transition: all 0.2s ease;
}
.btn-ghost:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.25); }

/* Chip / pill glass sombre */
.chip {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 11px; font-weight: 600;
  color: var(--color-ink);
  letter-spacing: 0.02em;
  backdrop-filter: blur(10px);
}
.chip.accent { background: rgba(232, 70, 31, 0.15); border-color: rgba(232, 70, 31, 0.4); color: var(--color-accent-soft); }
.chip.emerald { background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.4); color: #6EE7B7; }
.chip.amber { background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.4); color: #FCD34D; }
.chip.red { background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.4); color: #FCA5A5; }

/* Bordure hover subtile */
.hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
.hover-lift:hover { transform: translateY(-1px); }

/* Titres XXL élégants */
.h-hero {
  font-size: clamp(44px, 5.5vw, 88px);
  font-weight: 400;
  letter-spacing: -0.035em;
  line-height: 0.96;
  color: var(--color-ink);
  font-family: "Instrument Serif", Georgia, "Times New Roman", serif;
}
.h-section {
  font-size: clamp(24px, 2.5vw, 36px);
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.1;
  color: var(--color-ink);
  font-family: "Instrument Serif", Georgia, "Times New Roman", serif;
}
.h-display {
  font-family: "Instrument Serif", Georgia, "Times New Roman", serif;
  font-weight: 400;
  letter-spacing: -0.025em;
}

/* Accent highlight pour mots spéciaux */
.text-accent { color: var(--color-accent); }
.text-ink { color: var(--color-ink); }
.text-dim { color: var(--color-ink-dim); }

/* ============================================================
   Avatars NAIOM — animations "vivantes"
   ============================================================ */

.avatar-container {
  perspective: 600px;
  transform-style: preserve-3d;
}

@keyframes avatar-float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-7px) rotate(-1deg); }
}
.avatar-float { animation: avatar-float 5s ease-in-out infinite; }
.avatar-float:nth-child(2n) { animation-delay: -1.2s; animation-duration: 5.8s; }
.avatar-float:nth-child(3n) { animation-delay: -2.4s; animation-duration: 6.4s; }
.avatar-float:nth-child(5n) { animation-delay: -3.6s; animation-duration: 4.8s; }

@keyframes avatar-wave {
  0%, 70%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
  73% { transform: translateY(-4px) rotate(-8deg) scale(1.04); }
  76% { transform: translateY(-2px) rotate(10deg) scale(1.04); }
  79% { transform: translateY(-4px) rotate(-8deg) scale(1.04); }
  82% { transform: translateY(-2px) rotate(8deg) scale(1.04); }
  85% { transform: translateY(0) rotate(0deg) scale(1); }
}
.avatar-wave { animation: avatar-wave 8s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite; }
.avatar-wave:nth-child(2n) { animation-delay: -2.5s; }
.avatar-wave:nth-child(3n) { animation-delay: -4.5s; }
.avatar-wave:nth-child(5n) { animation-delay: -6.5s; }

.avatar-alive {
  animation: avatar-alive 8s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
}
@keyframes avatar-alive {
  0%   { transform: translateY(0) rotate(0deg) scale(1); }
  12%  { transform: translateY(-6px) rotate(-0.5deg) scale(1); }
  25%  { transform: translateY(0) rotate(0deg) scale(1); }
  38%  { transform: translateY(-6px) rotate(0.5deg) scale(1); }
  50%  { transform: translateY(0) rotate(0deg) scale(1); }
  62%  { transform: translateY(-3px) rotate(-7deg) scale(1.03); }
  65%  { transform: translateY(-5px) rotate(9deg) scale(1.04); }
  68%  { transform: translateY(-3px) rotate(-7deg) scale(1.03); }
  71%  { transform: translateY(-5px) rotate(9deg) scale(1.04); }
  74%  { transform: translateY(0) rotate(0deg) scale(1); }
  100% { transform: translateY(0) rotate(0deg) scale(1); }
}
.avatar-alive:nth-child(2n) { animation-delay: -3s; }
.avatar-alive:nth-child(3n) { animation-delay: -5s; }
.avatar-alive:nth-child(5n) { animation-delay: -7s; }

@keyframes avatar-halo {
  0%, 100% { opacity: 0.45; transform: scale(1); }
  50% { opacity: 0.65; transform: scale(1.08); }
}
.avatar-halo { animation: avatar-halo 4s ease-in-out infinite; }

@keyframes avatar-aura {
  0%, 100% {
    opacity: 0.55;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 0.85;
    transform: translate(-50%, -50%) scale(1.1);
  }
}
.avatar-aura-green {
  background: radial-gradient(
    circle,
    rgba(52, 211, 153, 0.45) 0%,
    rgba(16, 185, 129, 0.3) 30%,
    rgba(16, 185, 129, 0.08) 55%,
    transparent 75%
  );
  filter: blur(18px);
  animation: avatar-aura 3.5s ease-in-out infinite;
  z-index: 0;
}

@keyframes wave-emoji {
  0%, 58%, 80%, 100% { opacity: 0; transform: translateY(4px) scale(0.7) rotate(-20deg); }
  62%, 68%, 74% { opacity: 1; transform: translateY(-4px) scale(1) rotate(15deg); }
  65%, 71%      { transform: translateY(-4px) scale(1) rotate(-15deg); }
}
.wave-emoji { animation: wave-emoji 8s ease-in-out infinite; position: absolute; }

.agent-nav-chip {
  transform-origin: center center;
  transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
              border-color 180ms ease, box-shadow 180ms ease;
  will-change: transform;
}

.avatar-hub {
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform-style: preserve-3d;
}
.avatar-hub:hover {
  transform: perspective(500px) scale(1.08) rotateX(8deg) rotateY(-6deg);
}
.avatar-hub:active { transform: scale(0.95); }

@keyframes avatar-enter {
  from { opacity: 0; transform: translateY(30px) scale(0.92); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.avatar-enter { animation: avatar-enter 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both; }

.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
.no-scrollbar::-webkit-scrollbar { display: none; }

*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 999px; }
*::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }

.featured-glow {
  box-shadow:
    0 0 0 1px rgba(255, 255, 255, 0.08) inset,
    0 0 80px -10px rgba(232, 70, 31, 0.5),
    0 40px 100px -20px rgba(0, 0, 0, 0.8);
}

/* ============================================================
   Prose (livrables markdown) — dark
   ============================================================ */
.prose-naiom h1 { font-size: 1.5rem; font-weight: 500; color: var(--color-ink); margin-top: 1.25rem; margin-bottom: 0.5rem; letter-spacing: -0.02em; font-family: "Instrument Serif", serif; }
.prose-naiom h2 { font-size: 1.2rem; font-weight: 500; color: var(--color-ink); margin-top: 1rem; margin-bottom: 0.375rem; letter-spacing: -0.015em; font-family: "Instrument Serif", serif; }
.prose-naiom h3 { font-size: 1.02rem; font-weight: 600; color: var(--color-ink); margin-top: 0.75rem; margin-bottom: 0.25rem; }
.prose-naiom p { margin-bottom: 0.75rem; line-height: 1.65; color: var(--color-ink-soft); }
.prose-naiom ul, .prose-naiom ol { margin: 0.5rem 0 0.75rem 1.25rem; list-style: disc; color: var(--color-ink-soft); }
.prose-naiom ol { list-style: decimal; }
.prose-naiom li { margin-bottom: 0.25rem; line-height: 1.55; }
.prose-naiom code { background: rgba(255, 255, 255, 0.06); color: var(--color-accent-soft); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.85em; font-family: var(--font-mono); border: 1px solid rgba(255, 255, 255, 0.1); }
.prose-naiom pre { background: rgba(0, 0, 0, 0.4); color: var(--color-ink); padding: 0.75rem 1rem; border-radius: 12px; overflow-x: auto; font-size: 0.82rem; border: 1px solid rgba(255, 255, 255, 0.1); }
.prose-naiom pre code { background: transparent; color: inherit; padding: 0; border: 0; }
.prose-naiom table { border-collapse: collapse; margin: 0.75rem 0; font-size: 0.9rem; color: var(--color-ink-soft); }
.prose-naiom th, .prose-naiom td { border: 1px solid rgba(255, 255, 255, 0.08); padding: 0.35rem 0.6rem; text-align: left; }
.prose-naiom th { background: rgba(255, 255, 255, 0.04); font-weight: 600; color: var(--color-ink); }
.prose-naiom blockquote { border-left: 3px solid var(--color-accent); padding: 0.25rem 0.75rem; color: var(--color-ink-dim); font-style: italic; margin: 0.5rem 0; }
.prose-naiom hr { border: 0; border-top: 1px solid rgba(255, 255, 255, 0.1); margin: 1rem 0; }
.prose-naiom a { color: var(--color-accent); text-decoration: underline; font-weight: 600; }
.prose-naiom img { display: block; margin: 0.75rem auto; max-width: 320px; width: 100%; height: auto; border-radius: 12px; box-shadow: 0 8px 24px -12px rgba(0,0,0,0.5); }

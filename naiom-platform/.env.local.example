# Copier en .env.local et renseigner la clé avant le live.
# Le fichier .env.local est gitignoré par défaut dans Next.js.

# Clé Anthropic pour le streaming LLM (obligatoire en mode réel)
ANTHROPIC_API_KEY=

# Fallback démo : mettre 1 pour forcer le mock stream (utile si rate-limit live).
# Le mock renvoie une réponse canée courte par agent. Mettre 0 ou commenter pour désactiver.
DEMO_MOCK=0

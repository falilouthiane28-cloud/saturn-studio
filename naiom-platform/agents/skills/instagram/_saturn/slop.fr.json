  "structures": [
    {
      "id": "pas-seulement-fr",
      "regex": "(?i)\\bce n'est pas (?:seulement|juste|qu'un|qu'une) [^.!?\\n]{2,60}[,.] c'est\\b",
      "name": "« Ce n'est pas seulement X, c'est Y »",
      "fix": "Dis la seule chose que tu veux dire. Supprime la mise en place."
    },
    {
      "id": "non-seulement-fr",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
      "name": "« Non seulement X mais aussi Y »",
      "fix": "Deux phrases, ou garde la plus forte."
    },
    {
      "id": "il-ne-s-agit-pas-fr",
      "regex": "(?i)\\bil ne s'agit pas de [^.!?\\n]{2,60}[.!,] il s'agit de\\b",
      "name": "« Il ne s'agit pas de X. Il s'agit de Y. »",
      "fix": "Commence par Y. Le retournement est la signature."
    },
    {
      "id": "voici-ce-que-fr",
      "regex": "(?i)\\bvoici ce que (?:j'ai|nous avons) appris\\b",
      "name": "« Voici ce que j'ai appris »",
      "fix": "Donne directement la leçon."
    },
    {
      "id": "en-conclusion-fr",
      "regex": "(?im)^\\s*(?:en conclusion|pour conclure|pour résumer|en résumé)\\b",
      "name": "Conclusion scolaire",
      "fix": "Termine sur l'idée, pas sur l'annonce de la fin."
    },
    {
      "id": "appat-fr",
      "regex": "(?i)\\b(?:t'es d'accord \\?|vous êtes d'accord \\?|qui d'autre\\b|j'ai tort \\?)\\s*$",
      "name": "Appât à engagement",
      "fix": "Pose une vraie question précise, ou rien."
    },
    {
      "id": "dans-cette-video-fr",
      "regex": "(?i)\\b(?:dans (?:cette|ce) (?:vidéo|reel|post)|aujourd'hui je vais (?:te|vous) montrer|je vais (?:te|vous) (?:montrer|apprendre) comment)\\b",
      "name": "Préambule de vidéo",
      "fix": "Supprime-le, ouvre sur le résultat."
    }
  ]
}

# ===================================================================
# Saturn Studio — variables d'environnement de PRODUCTION
# Copier en `.env.local` SUR LE SERVEUR (jamais commité) et remplir.
# ===================================================================

# --- Cerveau des agents (OBLIGATOIRE) ---
# Vraie clé Anthropic (~100 caractères), pas le placeholder.
ANTHROPIC_API_KEY=sk-ant-...

# --- Mode plateforme complète (laisser vide) ---
OWNED_AGENT=

# --- Google OAuth (Gmail / Drive / YouTube) ---
GOOGLE_CLIENT_ID=903333556957-4tchva26uplq2pokdir4nkggknn67lfi.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-remplace-par-le-tien
# ⚠️ EN PROD : l'URI doit pointer vers TON domaine (https), et être ajoutée
# dans Google Cloud → Identifiants → URIs de redirection autorisés.
GOOGLE_REDIRECT_URI=https://TON-DOMAINE/api/integrations/google/callback

# --- TikTok ---
TIKTOK_ACCESS_TOKEN=remplace-par-le-tien

# --- Divers (optionnels, selon agents utilisés) ---
# APIFY_TOKEN=apify_api_...
# FIREFLIES_API_KEY=...
# AIRTABLE_TOKEN=pat...

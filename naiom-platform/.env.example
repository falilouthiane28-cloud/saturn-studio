# ================== CLÉ OBLIGATOIRE ==================
# Ta clé API Anthropic (Claude) — https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=

# ============== NE PAS MODIFIER (agent de ce template) ==============
OWNED_AGENT=proposition
NEXT_PUBLIC_OWNED_AGENT=proposition

# ============== OPTIONNEL ==============
# Lien pour "débloquer" les autres agents (email ou page de vente)
NEXT_PUBLIC_UNLOCK_URL=
# Clés selon les fonctionnalités de cet agent :
# FIREFLIES_API_KEY=   # calls (mode démo par défaut : FIREFLIES_MOCK=1)
# APIFY_TOKEN=            # scraping (prospection / veille)
# GEMINI_API_KEY=         # images (designer)
# FIREFLIES_API_KEY=      # analyse de calls
# GOOGLE_CLIENT_ID=       # Gmail / Google
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# WhatsApp Cloud API (Meta) — canal de prise de contact d'Awa (prospection)
# WHATSAPP_ACCESS_TOKEN=        # jeton System User permanent (whatsapp_business_messaging)
# WHATSAPP_PHONE_NUMBER_ID=     # ID du numéro expéditeur (onglet API Setup)
# WHATSAPP_BUSINESS_ACCOUNT_ID= # WABA id (pour la gestion des templates)
# WHATSAPP_API_VERSION=v21.0    # version de Graph API (défaut v21.0)
# WHATSAPP_DEFAULT_TEMPLATE=    # nom du template approuvé pour le 1er contact
# WHATSAPP_TEMPLATE_LANG=fr     # langue du template (défaut fr)
# WHATSAPP_RATE_PER_MIN=10      # garde de débit : envois max par minute
# WHATSAPP_DRY_RUN=false        # true = simule les envois (aucun appel à Meta)
